# Deep links the Moodle seed writes into assignment descriptions.
# WW_BASE: the WeBWorK course root (set pages are <WW_BASE>/<SET>/).
# PL_QUIZ1_URL: the PrairieLearn quiz1 assessment page. The PL course_instance
# and assessment ids are only known once PL is seeded, so the integrator fills
# them in here (PL serves quiz1 at 127.0.0.1:3100 .../assessment/3/ on a fresh seed: alphabetical sync order) and re-runs ./up.sh.
WW_BASE=http://localhost:8081/webwork2/math100_2026w1
PL_QUIZ1_URL=http://127.0.0.1:3100/pl/course_instance/1/assessment/3/
