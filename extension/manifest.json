{
  "manifest_version": 3,
  "name": "Lauds Sync",
  "version": "0.1.0",
  "description": "Capture tasks from connected education providers in your browser.",
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": [
    "https://canvas.ubc.ca/*",
    "https://piazza.com/*",
    "https://us.prairielearn.com/*",
    "https://hello-hacks26.vercel.app/*",
    "https://hello-hacks26-one.vercel.app/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "externally_connectable": {"matches": [
    "https://hello-hacks26.vercel.app/*",
    "https://hello-hacks26-one.vercel.app/*",
    "http://localhost/*"
  ]},
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"}
}
